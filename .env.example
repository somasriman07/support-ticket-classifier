# Provider API Keys (Set GROQ_API_KEY for Groq, or OPENAI_API_KEY for OpenAI)
GROQ_API_KEY=gsk_your_groq_key_here
# OPENAI_API_KEY=sk-your_openai_key_here

# Model selection (e.g., openai/gpt-oss-20b, llama-3.3-70b-versatile, or gpt-4o-mini)
DEFAULT_MODEL=openai/gpt-oss-20b

# Prompt version (v1 or v2)
PROMPT_VERSION=v2

# Cost logging flag (true / false)
LOG_COSTS=true
